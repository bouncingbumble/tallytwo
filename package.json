{
  "name": "tallytwo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite --host --port 5180 --strictPort",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host --port 4180",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --noEmit && tsc -p tsconfig.core.json --noEmit",
    "sim": "node --experimental-strip-types --import ./scripts/register-resolver.mjs scripts/sim.mjs",
    "check:sw": "node scripts/check-sw.mjs",
    "e2e": "node e2e/play.mjs",
    "check": "npm run typecheck && npm run lint && npm test && npm run sim -- 300 && vite build && npm run check:sw"
  },
  "dependencies": {
    "@fontsource/rye": "5.3.0",
    "phaser": "4.2.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
