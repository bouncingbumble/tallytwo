{
  "name": "tallytwo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --noEmit && tsc -p tsconfig.core.json --noEmit",
    "sim": "node --experimental-strip-types --import ./scripts/register-resolver.mjs scripts/sim.mjs",
    "check": "npm run typecheck && npm run lint && npm test && npm run sim -- 300 && vite build"
  },
  "dependencies": {
    "@fontsource/rye": "5.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "6.1.2",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "8.3.2",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.3"
  }
}
